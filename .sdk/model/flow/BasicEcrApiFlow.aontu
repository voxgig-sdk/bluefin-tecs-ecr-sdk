# BasicEcrApiFlow

main: kit: flow: BasicEcrApiFlow:
{
  entity: "ecr_api",
  kind: "basic",
  name: "BasicEcrApiFlow",
  step: [
    {
      i: {
        ref: "ecr_api_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "ecr_api_ref01",
        srcdatavar: "ecr_api_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ecr_api_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEcrApiFlow"
}
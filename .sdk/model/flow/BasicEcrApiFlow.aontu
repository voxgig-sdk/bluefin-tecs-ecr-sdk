  step: [
    {
      input: {
        ref: "ecr_api_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "ecr_api_ref01",
        srcdatavar: "ecr_api_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ecr_api_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEcrApiFlow"
}